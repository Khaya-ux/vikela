DATABASE_URL=postgres://postgres@localhost:5433/vikela
# Local Postgres without SSL. Remove for Supabase.
DATABASE_SSL=disable
# Optional model for the classifier. With neither key it uses rules only.
# Claude is used if its key is set, otherwise GPT-OSS on Groq. LLM_PROVIDER=anthropic|groq forces one.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=
LLM_PROVIDER=
